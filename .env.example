# ---- Database ----
DATABASE_URL=

# ---- Auth ----
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=

# ---- Site ----
# Used by layout metadata, robots.txt and sitemap.xml.
# NOTE: the code reads NEXT_PUBLIC_SITE_URL (the old BASE_URL key was unused).
NEXT_PUBLIC_SITE_URL=

# ---- Cloudinary ----
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Square ----
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
# "sandbox" (default) or "production"
SQUARE_ENVIRONMENT=sandbox
# From the Square developer dashboard webhook subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the notification URL registered with Square.
SQUARE_WEBHOOK_NOTIFICATION_URL=

# ---- Email (Resend) ----
RESEND_API_KEY=
FROM_EMAIL=
SUPPORT_EMAIL=

# ---- Canadian sales tax ----
# Leave false until the business is GST/HST registered with the CRA.
# A small supplier (under $30k over 4 consecutive quarters) must NOT collect tax.
TAX_ENABLED=false
# Printed on receipts once TAX_ENABLED=true (required by CRA for supplies over $30).
GST_HST_NUMBER=

# ---- Admin seeding (prisma/seed.ts only, not read at runtime) ----
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
